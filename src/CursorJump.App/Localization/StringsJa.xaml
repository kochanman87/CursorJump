<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- アプリ全般 -->
    <sys:String x:Key="Str.AppName">CursorJump</sys:String>
    <sys:String x:Key="Str.AlreadyRunning">CursorJump はすでに起動中です。タスクトレイを確認してください。</sys:String>

    <!-- トレイメニュー -->
    <sys:String x:Key="Str.Tray.Settings">設定</sys:String>
    <sys:String x:Key="Str.Tray.CheckForUpdates">更新を確認</sys:String>
    <sys:String x:Key="Str.Tray.Exit">終了</sys:String>

    <!-- 情報タブ / 自動更新 -->
    <sys:String x:Key="Str.Tab.About">情報</sys:String>
    <sys:String x:Key="Str.About.Version">バージョン: {0}</sys:String>
    <sys:String x:Key="Str.About.AutoUpdate">起動時に更新を確認</sys:String>
    <sys:String x:Key="Str.About.CheckNow">今すぐ更新を確認</sys:String>
    <sys:String x:Key="Str.About.LastChecked">前回確認: {0}</sys:String>
    <sys:String x:Key="Str.About.GitHubRepo">GitHub リポジトリ</sys:String>
    <sys:String x:Key="Str.About.Diagnostics">診断ログ</sys:String>
    <sys:String x:Key="Str.About.DiagnosticsHint">問題調査用のログを %APPDATA%\CursorJump\debug.log に出力します。マルチモニタでジャンプ位置がずれる等の不具合を報告する際に活用してください。</sys:String>
    <sys:String x:Key="Str.About.VerboseLogging">詳細ログを有効化</sys:String>
    <sys:String x:Key="Str.About.VerboseLoggingHint">ジャンプ前後のカーソル座標を毎回ログに記録します。常用すると動作が重くなる可能性があるため、調査時のみ ON にしてください。</sys:String>
    <sys:String x:Key="Str.About.OpenLog">ログを開く</sys:String>
    <sys:String x:Key="Str.About.OpenLogFolder">ログフォルダを開く</sys:String>
    <sys:String x:Key="Str.About.AutoStart">Windows 起動時に自動起動</sys:String>
    <sys:String x:Key="Str.About.AutoStartHint">Windows サインイン時に CursorJump を自動的に起動します。タスクトレイに常駐します。</sys:String>

    <!-- 更新ダイアログ -->
    <sys:String x:Key="Str.Update.DialogTitle">更新が利用可能です</sys:String>
    <sys:String x:Key="Str.Update.CurrentVersion">現在: {0}</sys:String>
    <sys:String x:Key="Str.Update.NewVersion">新バージョン: {0}</sys:String>
    <sys:String x:Key="Str.Update.UpdateNow">今すぐ更新</sys:String>
    <sys:String x:Key="Str.Update.Later">後で</sys:String>
    <sys:String x:Key="Str.Update.Skip">このバージョンをスキップ</sys:String>
    <sys:String x:Key="Str.Update.NoUpdate">最新版です。</sys:String>
    <sys:String x:Key="Str.Update.NotInstalled">インストール版ではないため更新チェックをスキップしました（開発実行）。</sys:String>
    <sys:String x:Key="Str.Update.NetworkError">更新の確認に失敗しました。ネットワーク接続または GitHub の状態を確認してください。詳細は debug.log を参照してください。</sys:String>
    <sys:String x:Key="Str.Update.CheckFailed">更新の確認に失敗しました: {0}</sys:String>

    <!-- 設定ウィンドウ全般 -->
    <sys:String x:Key="Str.Settings.Title">CursorJump 設定</sys:String>
    <sys:String x:Key="Str.Settings.TitleFormat">CursorJump 設定  v{0}.{1}.{2}</sys:String>
    <sys:String x:Key="Str.Settings.Tab.Settings">設定</sys:String>
    <sys:String x:Key="Str.Settings.Tab.Usage">使い方</sys:String>
    <sys:String x:Key="Str.Settings.Theme.Light">ライト</sys:String>
    <sys:String x:Key="Str.Settings.Theme.Dark">ダーク</sys:String>
    <sys:String x:Key="Str.Settings.Language.Japanese">日本語</sys:String>
    <sys:String x:Key="Str.Settings.Language.English">English</sys:String>

    <!-- カードヘッダ -->
    <sys:String x:Key="Str.Settings.Card.Save">座標保存</sys:String>
    <sys:String x:Key="Str.Settings.Card.Navigate">座標移動</sys:String>
    <sys:String x:Key="Str.Settings.Card.NavigateInMonitor">モニタ内移動</sys:String>
    <sys:String x:Key="Str.Settings.Card.NavigateInMonitor.Hint">現在モニタのみ循環</sys:String>
    <sys:String x:Key="Str.Settings.Card.Display">座標表示・削除</sys:String>
    <sys:String x:Key="Str.Settings.Card.SaveB">座標保存（2 つ目）</sys:String>
    <sys:String x:Key="Str.Settings.Card.NavigateB">座標移動（2 つ目）</sys:String>
    <sys:String x:Key="Str.Settings.Card.ActivateWindowOnJump">ジャンプ後にウィンドウをアクティブ化</sys:String>
    <sys:String x:Key="Str.Settings.ActivateWindowOnJump.Hint">カーソルのジャンプ先にウィンドウがあれば、そのウィンドウを前面化（フォーカス）します。</sys:String>
    <sys:String x:Key="Str.Settings.Card.Effects">エフェクト</sys:String>

    <!-- 共通ラベル -->
    <sys:String x:Key="Str.Settings.MouseButton">マウス</sys:String>
    <sys:String x:Key="Str.Settings.KeyboardKey">キーボード</sys:String>
    <sys:String x:Key="Str.Settings.FKeyTooltip">F13-F24 (VIA/QMK/AutoHotkey 等で送信) または Ctrl+Alt+Z のような任意キー+修飾キーが使えます。任意キーは他アプリにも届くパススルー方式。詳細は「使い方」タブ参照</sys:String>
    <sys:String x:Key="Str.Settings.RecordKey">キーを記録</sys:String>
    <sys:String x:Key="Str.Settings.RecordKeyWaiting">キーを押してください... (ESC でキャンセル)</sys:String>
    <sys:String x:Key="Str.Settings.KeyUnassigned">（未割当）</sys:String>
    <sys:String x:Key="Str.Settings.StatusEnabled">有効</sys:String>
    <sys:String x:Key="Str.Settings.StatusNotImplemented">未実装</sys:String>

    <!-- Set B セクション -->
    <sys:String x:Key="Str.Settings.SetB.Header">2 つ目の座標リスト</sys:String>
    <sys:String x:Key="Str.Settings.SetB.Description">上のセクションとは別に、もう 1 セットの座標を保存・循環できます。削除モード中は色分けで同時に表示されます。</sys:String>

    <!-- エフェクトカード -->
    <sys:String x:Key="Str.Settings.Effect.Save.Title">保存エフェクト</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Save.Hint">座標保存時の収縮円アニメーション</sys:String>
    <sys:String x:Key="Str.Settings.Effect.SaveB.Title">保存エフェクト（2 つ目）</sys:String>
    <sys:String x:Key="Str.Settings.Effect.SaveB.Hint">2 つ目の座標を保存した時の収縮円アニメーション色</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Trail.Title">ジャンプ軌跡</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Trail.Hint">カーソル移動時の軌跡ライン</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Trail.Thickness">軌跡の太さ</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Trail.Duration">持続時間</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Trail.Opacity">不透明度</sys:String>
    <sys:String x:Key="Str.Settings.Effect.TrailB.Title">ジャンプ軌跡（2 つ目）</sys:String>
    <sys:String x:Key="Str.Settings.Effect.TrailB.Hint">2 つ目の座標へ移動した時の軌跡ライン色</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Marker.Title">座標マーカー</sys:String>
    <sys:String x:Key="Str.Settings.Effect.Marker.Hint">表示モード時の保存座標マーカー</sys:String>
    <sys:String x:Key="Str.Settings.Effect.MarkerB.Title">座標マーカー（2 つ目）</sys:String>
    <sys:String x:Key="Str.Settings.Effect.MarkerB.Hint">2 つ目の座標リストのマーカー色（削除モードで色分け表示）</sys:String>
    <sys:String x:Key="Str.Settings.Effect.DeleteHelp.Title">削除モードヘルプ</sys:String>
    <sys:String x:Key="Str.Settings.Effect.DeleteHelp.Hint">削除モード中に操作ガイドを画面隅に表示</sys:String>
    <sys:String x:Key="Str.Settings.Effect.MoveTrail.Title">マウス移動エフェクト</sys:String>
    <sys:String x:Key="Str.Settings.Effect.MoveTrail.Hint">（将来追加予定）カーソル移動時のトレイル</sys:String>

    <!-- ボタン -->
    <sys:String x:Key="Str.Settings.Cancel">キャンセル</sys:String>
    <sys:String x:Key="Str.Settings.Save">保存</sys:String>

    <!-- バリデーション・エラー -->
    <sys:String x:Key="Str.Settings.Validation.NoTrigger">座標保存・座標移動・座標表示・削除の各アクションにつき、マウスボタンまたはキーボードキーを少なくとも1つ有効にしてください。</sys:String>
    <sys:String x:Key="Str.Settings.Validation.NoModifier">左/右/ホイールクリック（単押し）の場合は修飾キーを1つ以上選択してください。ホイール＋L/R、ホイール連打、戻る/進むボタンは修飾キー不要で使用できます。</sys:String>
    <sys:String x:Key="Str.Settings.Validation.KeyboardNoModifier">F13-F24 以外のキー（A-Z, 0-9 など）を割り当てる場合は、誤発火を防ぐため修飾キーを1つ以上選択してください。F13-F24 は修飾キー無しで使用できます。</sys:String>
    <sys:String x:Key="Str.Settings.Validation.ConflictFormat">「{0}」と「{1}」の{2}ショートカットが重複しています。どちらか片方を変更してください。</sys:String>
    <sys:String x:Key="Str.Settings.Validation.ConflictKind.Mouse">マウス</sys:String>
    <sys:String x:Key="Str.Settings.Validation.ConflictKind.Keyboard">キーボード</sys:String>
    <sys:String x:Key="Str.Settings.Validation.ConflictKind.Both">マウス/キーボード両方の</sys:String>

    <!-- アクション名（競合エラーで使用） -->
    <sys:String x:Key="Str.Settings.Action.Save">座標保存</sys:String>
    <sys:String x:Key="Str.Settings.Action.NavigateAll">座標移動（全体）</sys:String>
    <sys:String x:Key="Str.Settings.Action.NavigateMonitor">座標移動（モニタ内）</sys:String>
    <sys:String x:Key="Str.Settings.Action.Display">座標表示・削除</sys:String>
    <sys:String x:Key="Str.Settings.Action.SaveB">座標保存（2 つ目）</sys:String>
    <sys:String x:Key="Str.Settings.Action.NavigateB">座標移動（2 つ目）</sys:String>

    <!-- マウスボタン名 -->
    <sys:String x:Key="Str.Button.Left">左クリック</sys:String>
    <sys:String x:Key="Str.Button.Right">右クリック</sys:String>
    <sys:String x:Key="Str.Button.Middle">ホイールクリック</sys:String>
    <sys:String x:Key="Str.Button.XButton1">戻るボタン</sys:String>
    <sys:String x:Key="Str.Button.XButton2">進むボタン</sys:String>
    <sys:String x:Key="Str.Button.MiddleLeftChord">ホイール＋左クリック</sys:String>
    <sys:String x:Key="Str.Button.MiddleRightChord">ホイール＋右クリック</sys:String>
    <sys:String x:Key="Str.Button.MiddleDoubleClick">ホイール2連打</sys:String>
    <sys:String x:Key="Str.Button.MiddleTripleClick">ホイール3連打</sys:String>
    <sys:String x:Key="Str.Button.WheelUp">ホイール上スクロール</sys:String>
    <sys:String x:Key="Str.Button.WheelDown">ホイール下スクロール</sys:String>
    <sys:String x:Key="Str.Button.MouseWheel">マウスホイール</sys:String>
    <!-- 削除モードヘルプ用（FormatForDeleteMode で使用、表記揺れあり） -->
    <sys:String x:Key="Str.Button.Compact.MiddleLeftChord">ホイール+左クリック</sys:String>
    <sys:String x:Key="Str.Button.Compact.MiddleRightChord">ホイール+右クリック</sys:String>
    <sys:String x:Key="Str.Button.Compact.MiddleDoubleClick">ホイールダブルクリック</sys:String>
    <sys:String x:Key="Str.Button.Compact.MiddleTripleClick">ホイールトリプルクリック</sys:String>

    <!-- ショートカット -->
    <sys:String x:Key="Str.Shortcut.Disabled">（無効）</sys:String>

    <!-- MessageBox -->
    <sys:String x:Key="Str.MessageBox.MouseHookFailedFormat">マウスフックの登録に失敗しました: {0}</sys:String>
    <sys:String x:Key="Str.MessageBox.KeyboardHookFailedFormat">キーボードフックの登録に失敗しました: {0}</sys:String>
    <sys:String x:Key="Str.MessageBox.SettingsSaveFailed">設定の保存に失敗しました。ディスクの空き容量や書き込み権限を確認してください。</sys:String>

    <!-- オーバーレイ（削除モード） -->
    <sys:String x:Key="Str.Overlay.DeleteMode.Title">保存座標削除モード</sys:String>
    <sys:String x:Key="Str.Overlay.DeleteMode.AddDelete">追加/削除</sys:String>
    <sys:String x:Key="Str.Overlay.DeleteMode.DeleteAll">全削除</sys:String>
    <sys:String x:Key="Str.Overlay.DeleteMode.Exit">終了</sys:String>
    <sys:String x:Key="Str.Overlay.DeleteMode.DoubleClick">ダブルクリック</sys:String>
    <sys:String x:Key="Str.Overlay.DeleteMode.AddSetB">追加 (2 つ目)</sys:String>

    <!-- 使い方タブ -->
    <sys:String x:Key="Str.Usage.WhatIs.Title">CursorJumpとは</sys:String>
    <sys:String x:Key="Str.Usage.WhatIs.Body">CursorJump は、マウスカーソルを瞬間移動するツールです。</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Title">基本操作</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step1.Title">座標保存</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step1.Prefix">移動先の位置にカーソルを置いて、</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step1.Suffix">+ 左クリック</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step2.Title">座標移動</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step2.Body">移動ショートカットで保存した座標を順に循環します。</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step3.Title">モニタ内移動</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step3.Body">今カーソルがあるモニタの座標だけを循環します。</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step4.Title">座標表示・削除</sys:String>
    <sys:String x:Key="Str.Usage.Basics.Step4.Body">マーカー付近をクリックで削除、空き場所をクリックで追加、ESC で終了します。空き場所をダブルクリックすると 2 つ目の座標リストに追加されます（Pro 版）。</sys:String>

    <!-- ライセンス -->
    <sys:String x:Key="Str.Edition.Free">Free 版</sys:String>
    <sys:String x:Key="Str.Edition.Pro">Pro 版</sys:String>
    <sys:String x:Key="Str.License.Tab">ライセンス</sys:String>
    <sys:String x:Key="Str.License.Header">Pro ライセンス</sys:String>
    <sys:String x:Key="Str.License.KeyLabel">ライセンスキー</sys:String>
    <sys:String x:Key="Str.License.KeyPlaceholder">BOOTH 購入時に配布されたキーを貼り付け</sys:String>
    <sys:String x:Key="Str.License.ApplyButton">適用</sys:String>
    <sys:String x:Key="Str.License.StatusFree">未認証（Free 版として動作中）</sys:String>
    <sys:String x:Key="Str.License.StatusPro">認証済み（Pro 版）</sys:String>
    <sys:String x:Key="Str.License.StatusInvalid">無効なキーです。BOOTH で購入したキーを再確認してください。</sys:String>
    <sys:String x:Key="Str.License.StatusValidApplied">ライセンスを適用しました。Pro 機能が解放されました。</sys:String>
    <sys:String x:Key="Str.License.BuyHint">Pro 版を購入すると、座標保存の上限解除と 2 つ目の座標リストが利用できます。</sys:String>
    <sys:String x:Key="Str.License.BuyButton">BOOTH で Pro を購入</sys:String>
    <sys:String x:Key="Str.License.FreeLimits">Free 版の制限: 座標保存は {0} 個まで、2 つ目の座標リストは使用不可</sys:String>

    <!-- アップグレード案内 -->
    <sys:String x:Key="Str.Upgrade.Title">Pro 版限定機能</sys:String>
    <sys:String x:Key="Str.Upgrade.SetBBody">2 つ目の座標リストは Pro 版限定の機能です。基本の座標リストとは別のショートカットで、追加の座標を保存・循環できます。Pro ライセンスを適用すると有効になります。</sys:String>
    <sys:String x:Key="Str.Upgrade.SaveLimitBodyFormat">Free 版では座標を {0} 個まで保存できます。Pro 版にアップグレードすると上限なしで保存できるようになります。</sys:String>
    <sys:String x:Key="Str.Upgrade.OpenLicenseTab">ライセンスタブを開く</sys:String>
    <sys:String x:Key="Str.Upgrade.Close">閉じる</sys:String>

    <!-- Set B PRO バッジ -->
    <sys:String x:Key="Str.Settings.SetB.ProBadge">PRO</sys:String>
    <sys:String x:Key="Str.Settings.SetB.ProLocked">この機能は Pro 版でのみ動作します。設定は変更できますが、Free 版ではトリガーは反応しません。</sys:String>

</ResourceDictionary>
