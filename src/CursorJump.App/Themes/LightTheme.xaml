<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light テーマのカラーリソース -->
    <SolidColorBrush x:Key="BgPrimaryBrush"    Color="#F5F5F7"/>
    <SolidColorBrush x:Key="BgCardBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardHoverBrush"  Color="#FAFAFA"/>
    <SolidColorBrush x:Key="BgInputBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6B70"/>
    <SolidColorBrush x:Key="TextMutedBrush"    Color="#9A9AA0"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#C7C7CC"/>
    <SolidColorBrush x:Key="BorderInputBrush"  Color="#B0B0B5"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#106EBE"/>
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#1A0078D4"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SwitchThumbBrush"  Color="#FFFFFF"/>
</ResourceDictionary>
