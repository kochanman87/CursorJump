<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark テーマのカラーリソース -->
    <SolidColorBrush x:Key="BgPrimaryBrush"    Color="#1E1E20"/>
    <SolidColorBrush x:Key="BgCardBrush"       Color="#2A2A2D"/>
    <SolidColorBrush x:Key="BgCardHoverBrush"  Color="#313135"/>
    <SolidColorBrush x:Key="BgInputBrush"      Color="#38383C"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4B4B8"/>
    <SolidColorBrush x:Key="TextMutedBrush"    Color="#808086"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="BorderInputBrush"  Color="#48484C"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="#4CC2FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="#60CAFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush"   Color="#264CC2FF"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1E1E20"/>
    <SolidColorBrush x:Key="SwitchThumbBrush"  Color="#FFFFFF"/>
</ResourceDictionary>
