<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!--
    DPI awareness は必ずこのマニフェストで宣言する (v1.9.2 で復元)。
    csproj の ApplicationHighDpiMode は WinForms 専用 (ApplicationConfiguration.Initialize() を
    呼ぶアプリのみ有効) で、WPF エントリポイントの本アプリでは効かない。
    v1.1.0 で WFAC010 警告解消のため誤ってそちらへ「移行」した結果、プロセスが
    System DPI Aware に落ち、混在 DPI 環境で座標系が破綻していた。
    注意: <dpiAware>PerMonitorV2</dpiAware> は無効値で USER32 が 0xC0000409 クラッシュする。
    必ず <dpiAware>true/pm</dpiAware> + <dpiAwareness>PerMonitorV2</dpiAwareness> の2要素形式で書く。
  -->
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
