<Window x:Class="CursorJump.App.UpgradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Upgrade.Title}"
        Width="460" Height="280"
        MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7EF;"
                       FontSize="22" Margin="0,0,10,0"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str.Upgrade.Title}"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 本文 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,12">
            <TextBlock x:Name="BodyText"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="20"/>
        </Border>

        <!-- ボタン -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton"
                    Content="{DynamicResource Str.Upgrade.Close}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnCloseClick"
                    Margin="0,0,8,0"/>
            <Button x:Name="OpenLicenseTabButton"
                    Content="{DynamicResource Str.Upgrade.OpenLicenseTab}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnOpenLicenseTabClick"/>
        </StackPanel>
    </Grid>
</Window>
