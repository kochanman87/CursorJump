<Window x:Class="CursorJump.App.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Update.DialogTitle}"
        Width="540" Height="460"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE777;"
                       FontSize="22" Margin="0,0,10,0"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str.Update.DialogTitle}"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- バージョン情報 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="CurrentVersionText" FontSize="13" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="NewVersionText" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- リリースノート -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <TextBlock x:Name="ReleaseNotesText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           LineHeight="18"/>
            </ScrollViewer>
        </Border>

        <!-- 進捗バー -->
        <StackPanel Grid.Row="3" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock x:Name="ProgressText" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>
            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton"
                    Content="{DynamicResource Str.Update.Skip}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnSkipClick"
                    Margin="0,0,8,0"/>
            <Button x:Name="LaterButton"
                    Content="{DynamicResource Str.Update.Later}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnLaterClick"
                    Margin="0,0,8,0"/>
            <Button x:Name="UpdateButton"
                    Content="{DynamicResource Str.Update.UpdateNow}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnUpdateClick"/>
        </StackPanel>
    </Grid>
</Window>
