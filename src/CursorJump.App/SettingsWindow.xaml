<Window x:Class="CursorJump.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorJump 設定"
        Width="740" Height="820"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==== Header: ページタブ + テーマ切替 ==== -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ページタブ（設定 / 使い方） -->
            <Border Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource PillTabContainer}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabSettings" GroupName="PageTabs" IsChecked="True"
                                 Style="{StaticResource PillTabStyle}"
                                 Checked="OnTabSettingsChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE713;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="設定" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabUsage" GroupName="PageTabs"
                                 Style="{StaticResource PillTabStyle}"
                                 Checked="OnTabUsageChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE897;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="使い方" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- テーマ切替（ライト / ダーク） -->
            <Border Grid.Column="1" Style="{StaticResource PillTabContainer}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeLight" GroupName="ThemeToggle" IsChecked="True"
                                 Style="{StaticResource PillTabStyle}"
                                 Padding="10,5"
                                 Checked="OnThemeLightChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE706;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="ライト" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ThemeDark" GroupName="ThemeToggle"
                                 Style="{StaticResource PillTabStyle}"
                                 Padding="10,5"
                                 Checked="OnThemeDarkChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE708;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="ダーク" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==== ページ内容 ==== -->
        <Grid Grid.Row="1">

            <!-- ====== 設定ページ ====== -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,8">
                <StackPanel>

                    <!-- 2x2 ショートカットカード -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: 座標保存 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74E;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="座標保存" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- マウスボタン行 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="マウスボタン"/>
                                    <CheckBox x:Name="ChkSaveMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlSaveMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkSaveCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkSaveAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                        <CheckBox x:Name="ChkSaveShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkSaveWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbSaveBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- キーボードキー行 -->
                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="キーボードキー"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="F13-F24 は VIA/QMK/AutoHotkey 等で送信できる拡張キー。詳細は「使い方」タブ参照">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSaveKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlSaveKeyboard" Margin="0,0,0,4" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbSaveKey" Style="{StaticResource ModernComboBoxStyle}" Width="100" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 座標ナビゲーション -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72A;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="座標ナビゲーション" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="マウスボタン"/>
                                    <CheckBox x:Name="ChkNavMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlNavMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkNavCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkNavAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                        <CheckBox x:Name="ChkNavShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkNavWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbNavBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="キーボードキー"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="F13-F24 は VIA/QMK/AutoHotkey 等で送信できる拡張キー。詳細は「使い方」タブ参照">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkNavKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlNavKeyboard" Margin="0,0,0,4" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbNavKey" Style="{StaticResource ModernComboBoxStyle}" Width="100" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: モニタ内ナビゲーション -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7F4;"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource CardHeaderText}" Text="モニタ内ナビゲーション"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="現在モニタのみ循環"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="マウスボタン"/>
                                    <CheckBox x:Name="ChkMonNavMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlMonNavMouse" Margin="0,4,0,4" Visibility="Collapsed">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkMonNavCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkMonNavAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                        <CheckBox x:Name="ChkMonNavShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkMonNavWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbMonNavBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="キーボードキー"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="F13-F24 は VIA/QMK/AutoHotkey 等で送信できる拡張キー。詳細は「使い方」タブ参照">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkMonNavKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlMonNavKeyboard" Margin="0,0,0,4" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbMonNavKey" Style="{StaticResource ModernComboBoxStyle}" Width="100" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: 座標表示/削除 -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7B3;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="座標表示 / 削除" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="マウスボタン"/>
                                    <CheckBox x:Name="ChkDispMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlDispMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkDispCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkDispAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                        <CheckBox x:Name="ChkDispShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkDispWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbDispBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="キーボードキー"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="F13-F24 は VIA/QMK/AutoHotkey 等で送信できる拡張キー。詳細は「使い方」タブ参照">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkDispKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlDispKeyboard" Margin="0,0,0,4" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbDispKey" Style="{StaticResource ModernComboBoxStyle}" Width="100" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ==== エフェクトカード ==== -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE790;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="エフェクト" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="EffectList">
                                <!-- 保存エフェクト -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectSaveColor" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="保存エフェクト" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="座標保存時の収縮円アニメーション"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="有効" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtSaveColorHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <CheckBox x:Name="ChkSaveEffectEnabled" Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>

                                <!-- 軌跡エフェクト -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectTrailColor" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="ジャンプ軌跡" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="カーソル移動時の軌跡ライン"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="有効" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtTrailColorHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <CheckBox x:Name="ChkTrailEffectEnabled" Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>

                                <!-- マーカー -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectMarkerColor" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="座標マーカー" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="表示モード時の保存座標マーカー"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="有効" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtMarkerColorHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <CheckBox x:Name="ChkMarkerEffectEnabled" Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>

                                <!-- マウス移動エフェクト（未実装プレースホルダ） -->
                                <Grid Margin="0,6" IsEnabled="False" Opacity="0.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             Fill="#FFCC00"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="マウス移動エフェクト" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="（将来追加予定）カーソル移動時のトレイル"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeDisabledStyle}">
                                        <TextBlock Text="未実装" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock Text="#FFCC00" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <CheckBox Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="False" IsEnabled="False"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ====== 使い方ページ ====== -->
            <ScrollViewer x:Name="PageUsage" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,8"
                          Visibility="Collapsed">
                <StackPanel>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE946;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="CursorJumpとは" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       Text="CursorJumpは、よく使う画面の位置にマウスカーソルを瞬間移動できる常駐ツールです。広いモニタ・マルチモニタ環境で、マウスを大きく動かす手間を減らします。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74E;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="基本操作" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="4,4,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="①" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="座標を保存" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="ジャンプ先にしたい位置にカーソルを置き、" Style="{StaticResource BodyText}"/>
                                            <Border Style="{StaticResource KbdKeyStyle}"><TextBlock Text="Ctrl" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/></Border>
                                            <TextBlock Text="+" Style="{StaticResource BodyText}" Margin="2,0"/>
                                            <Border Style="{StaticResource KbdKeyStyle}"><TextBlock Text="Win" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/></Border>
                                            <TextBlock Text="+ 左クリック" Style="{StaticResource BodyText}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="②" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="保存位置に移動" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                                   Text="ナビゲーションショートカットで保存した座標を順番に循環。マルチモニタなら全座標を横断して巡回します。"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="③" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="現在モニタのみ循環" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                                   Text="モニタ内ナビゲーションは、今カーソルがあるモニタの座標だけを循環します。"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="④" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="座標の表示 / 削除" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                                   Text="表示モードに入ると保存位置にマーカーが表示されます。マーカー付近をクリックで削除、何もない場所をクリックで新規追加、ESCで終了。"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE765;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="キーボードトリガー（F13〜F24）について" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       Text="F13〜F24 は、通常のキーボードには物理キーとして存在しない「拡張ファンクションキー」です。以下の方法で送信できます:"
                                       Margin="0,0,0,8"/>
                            <StackPanel Margin="4,0">
                                <TextBlock Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    • <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">VIA / QMK 対応キーボード</Run> — 任意のキーに F13〜F24 を割り当て可能
                                </TextBlock>
                                <TextBlock Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    • <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">AutoHotkey</Run> — スクリプトで既存キーを F13〜F24 に変換
                                </TextBlock>
                                <TextBlock Margin="0,2" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                    • <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">マクロ付きマウス / 周辺機器</Run> — 物理ボタンから送信
                                </TextBlock>
                            </StackPanel>
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="12,10" Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="💡 なぜ F13〜F24? — 通常のキー (A-Z, F1-F12) は他アプリと競合するため、専用領域として用意されている F13 以降を使うと安全に独自ショートカットが組めます。"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7F4;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="モニタ内ナビゲーションとは" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       Text="通常のナビゲーションは「全モニタの全保存座標」を順番に循環しますが、モニタ内ナビゲーションは現在カーソルのあるモニタに保存された座標のみを循環します。マルチモニタ環境で「今のモニタの中だけを行き来したい」場合に便利です。"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ==== ボタン行 ==== -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}"
                        Width="100" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"
                        Width="100" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
