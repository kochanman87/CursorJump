<Window x:Class="CursorJump.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorJump 設定"
        Width="500" Height="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 座標保存ショートカット -->
        <GroupBox Grid.Row="0" Header="座標保存">
            <StackPanel>
                <CheckBox x:Name="ChkSaveMouseEnabled" Content="マウスボタン" Margin="0,2,0,2"
                          Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                <WrapPanel x:Name="PnlSaveMouse" Margin="16,0,0,4">
                    <CheckBox x:Name="ChkSaveCtrl" Content="Ctrl"/>
                    <CheckBox x:Name="ChkSaveAlt" Content="Alt"/>
                    <CheckBox x:Name="ChkSaveShift" Content="Shift"/>
                    <CheckBox x:Name="ChkSaveWin" Content="Win"/>
                    <TextBlock Text=" + " VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbSaveBtn" Width="120" Margin="4,0"/>
                </WrapPanel>
                <CheckBox x:Name="ChkSaveKeyboardEnabled" Content="キーボードキー（F13-F24）" Margin="0,2,0,2"
                          Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                <WrapPanel x:Name="PnlSaveKeyboard" Margin="16,0,0,4" Visibility="Collapsed">
                    <ComboBox x:Name="CmbSaveKey" Width="80" Margin="0,0,4,0"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- 座標ナビゲーションショートカット -->
        <GroupBox Grid.Row="1" Header="座標ナビゲーション">
            <StackPanel>
                <CheckBox x:Name="ChkNavMouseEnabled" Content="マウスボタン" Margin="0,2,0,2"
                          Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                <WrapPanel x:Name="PnlNavMouse" Margin="16,0,0,4">
                    <CheckBox x:Name="ChkNavCtrl" Content="Ctrl"/>
                    <CheckBox x:Name="ChkNavAlt" Content="Alt"/>
                    <CheckBox x:Name="ChkNavShift" Content="Shift"/>
                    <CheckBox x:Name="ChkNavWin" Content="Win"/>
                    <TextBlock Text=" + " VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbNavBtn" Width="120" Margin="4,0"/>
                </WrapPanel>
                <CheckBox x:Name="ChkNavKeyboardEnabled" Content="キーボードキー（F13-F24）" Margin="0,2,0,2"
                          Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                <WrapPanel x:Name="PnlNavKeyboard" Margin="16,0,0,4" Visibility="Collapsed">
                    <ComboBox x:Name="CmbNavKey" Width="80" Margin="0,0,4,0"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- 座標表示/削除ショートカット -->
        <GroupBox Grid.Row="2" Header="座標表示/削除">
            <StackPanel>
                <CheckBox x:Name="ChkDispMouseEnabled" Content="マウスボタン" Margin="0,2,0,2"
                          Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                <WrapPanel x:Name="PnlDispMouse" Margin="16,0,0,4">
                    <CheckBox x:Name="ChkDispCtrl" Content="Ctrl"/>
                    <CheckBox x:Name="ChkDispAlt" Content="Alt"/>
                    <CheckBox x:Name="ChkDispShift" Content="Shift"/>
                    <CheckBox x:Name="ChkDispWin" Content="Win"/>
                    <TextBlock Text=" + " VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbDispBtn" Width="120" Margin="4,0"/>
                </WrapPanel>
                <CheckBox x:Name="ChkDispKeyboardEnabled" Content="キーボードキー（F13-F24）" Margin="0,2,0,2"
                          Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                <WrapPanel x:Name="PnlDispKeyboard" Margin="16,0,0,4" Visibility="Collapsed">
                    <ComboBox x:Name="CmbDispKey" Width="80" Margin="0,0,4,0"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- 色設定 -->
        <GroupBox Grid.Row="3" Header="アニメーション色">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="保存エフェクト:" VerticalAlignment="Center" Margin="4"/>
                <Rectangle x:Name="RectSaveColor" Grid.Row="0" Grid.Column="1" Height="28" Margin="4"
                           Stroke="Gray" StrokeThickness="1" Cursor="Hand"
                           MouseLeftButtonDown="OnColorRectangleClick"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="軌跡:" VerticalAlignment="Center" Margin="4"/>
                <Rectangle x:Name="RectTrailColor" Grid.Row="1" Grid.Column="1" Height="28" Margin="4"
                           Stroke="Gray" StrokeThickness="1" Cursor="Hand"
                           MouseLeftButtonDown="OnColorRectangleClick"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="マーカー:" VerticalAlignment="Center" Margin="4"/>
                <Rectangle x:Name="RectMarkerColor" Grid.Row="2" Grid.Column="1" Height="28" Margin="4"
                           Stroke="Gray" StrokeThickness="1" Cursor="Hand"
                           MouseLeftButtonDown="OnColorRectangleClick"/>
            </Grid>
        </GroupBox>

        <!-- ボタン -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="保存" Width="80" Margin="4" Click="OnSaveClick"/>
            <Button Content="キャンセル" Width="80" Margin="4" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
