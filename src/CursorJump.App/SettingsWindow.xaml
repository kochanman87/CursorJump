<Window x:Class="CursorJump.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Settings.Title}"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="740" Height="820"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==== Header: ページタブ + テーマ切替 ==== -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ページタブ（設定 / 使い方） -->
            <Border Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource PillTabContainer}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabSettings" GroupName="PageTabs" IsChecked="True"
                                 Style="{StaticResource PillTabStyle}"
                                 Checked="OnTabSettingsChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE713;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Settings.Tab.Settings}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabUsage" GroupName="PageTabs"
                                 Style="{StaticResource PillTabStyle}"
                                 Checked="OnTabUsageChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE897;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Settings.Tab.Usage}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabAbout" GroupName="PageTabs"
                                 Style="{StaticResource PillTabStyle}"
                                 Checked="OnTabAboutChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE946;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Tab.About}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabLicense" GroupName="PageTabs"
                                 Style="{StaticResource PillTabStyle}"
                                 Checked="OnTabLicenseChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE192;"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.License.Tab}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- 言語切替 + テーマ切替 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <!-- 言語切替（日本語 / English） -->
                <Border Style="{StaticResource PillTabContainer}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangJa" GroupName="LangToggle" IsChecked="True"
                                     Style="{StaticResource PillTabStyle}"
                                     Padding="10,5"
                                     Checked="OnLangJaChecked">
                            <TextBlock Text="{DynamicResource Str.Settings.Language.Japanese}" VerticalAlignment="Center" FontSize="12"/>
                        </RadioButton>
                        <RadioButton x:Name="LangEn" GroupName="LangToggle"
                                     Style="{StaticResource PillTabStyle}"
                                     Padding="10,5"
                                     Checked="OnLangEnChecked">
                            <TextBlock Text="{DynamicResource Str.Settings.Language.English}" VerticalAlignment="Center" FontSize="12"/>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- テーマ切替（ライト / ダーク） -->
                <Border Style="{StaticResource PillTabContainer}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeLight" GroupName="ThemeToggle" IsChecked="True"
                                     Style="{StaticResource PillTabStyle}"
                                     Padding="10,5"
                                     Checked="OnThemeLightChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE706;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Str.Settings.Theme.Light}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ThemeDark" GroupName="ThemeToggle"
                                     Style="{StaticResource PillTabStyle}"
                                     Padding="10,5"
                                     Checked="OnThemeDarkChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE708;"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                           FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{DynamicResource Str.Settings.Theme.Dark}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==== ページ内容 ==== -->
        <Grid Grid.Row="1">

            <!-- ====== 設定ページ ====== -->
            <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,8">
                <StackPanel>

                    <!-- 2x2 ショートカットカード -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: 座標保存 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74E;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.Save}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- マウスボタン行 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkSaveMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlSaveMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkSaveShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkSaveCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkSaveWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkSaveAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbSaveBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- キーボードキー行 -->
                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="{DynamicResource Str.Settings.FKeyTooltip}">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSaveKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlSaveKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="140" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblSaveKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnSaveKeyRecord" Tag="Save" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnSaveKeyClear" Tag="Save" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: 座標ナビゲーション -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72A;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.Navigate}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkNavMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlNavMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkNavShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkNavCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkNavWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkNavAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbNavBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="{DynamicResource Str.Settings.FKeyTooltip}">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkNavKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlNavKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="140" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblNavKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnNavKeyRecord" Tag="Nav" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnNavKeyClear" Tag="Nav" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: モニタ内ナビゲーション -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7F4;"/>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.NavigateInMonitor}"/>
                                        <TextBlock Style="{StaticResource HintText}" Text="{DynamicResource Str.Settings.Card.NavigateInMonitor.Hint}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkMonNavMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlMonNavMouse" Margin="0,4,0,4" Visibility="Collapsed">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkMonNavShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkMonNavCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkMonNavWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkMonNavAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbMonNavBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="{DynamicResource Str.Settings.FKeyTooltip}">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkMonNavKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlMonNavKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="140" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblMonNavKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnMonNavKeyRecord" Tag="MonNav" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnMonNavKeyClear" Tag="MonNav" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: 座標表示/削除 -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7B3;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.Display}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkDispMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlDispMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkDispShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkDispCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkDispWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkDispAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbDispBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="{DynamicResource Str.Settings.FKeyTooltip}">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkDispKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlDispKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="140" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblDispKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnDispKeyRecord" Tag="Disp" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnDispKeyClear" Tag="Disp" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ==== 第2座標セット（独立 / Set B） ==== -->
                    <StackPanel Margin="0,12,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.Settings.SetB.Header}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="SetBProBadge" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Settings.SetB.ProBadge}"
                                           FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.SetB.Description}"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SetBProLockedNotice"
                                   Text="{DynamicResource Str.Settings.SetB.ProLocked}"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card B1: 座標保存（Set B） -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74E;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.SaveB}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkSaveBMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlSaveBMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkSaveBShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkSaveBCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkSaveBWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkSaveBAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbSaveBBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="{DynamicResource Str.Settings.FKeyTooltip}">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkSaveBKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlSaveBKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="140" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblSaveBKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnSaveBKeyRecord" Tag="SaveB" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnSaveBKeyClear" Tag="SaveB" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card B2: 座標移動（Set B） -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72A;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.NavigateB}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkNavBMouseEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlNavBMouse" Margin="0,4,0,4">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkNavBShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkNavBCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkNavBWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkNavBAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbNavBBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <Border Style="{StaticResource HintBadgeStyle}" ToolTip="{DynamicResource Str.Settings.FKeyTooltip}">
                                            <TextBlock Text="?" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkNavBKeyboardEnabled" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlNavBKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="140" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblNavBKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnNavBKeyRecord" Tag="NavB" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnNavBKeyClear" Tag="NavB" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ==== Pro 追加機能（v1.9.0+） ==== -->
                    <StackPanel Margin="0,12,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.Settings.ProFeatures.Header}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border x:Name="ProFeaturesProBadge" Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Settings.SetB.ProBadge}"
                                           FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str.Settings.ProFeatures.Description}"
                                   Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pro Card 1: ジャンプ循環リセット -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE72C;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.ResetCycle}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Str.Settings.Card.ResetCycle.Desc}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkResetMouseEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlResetMouse" Margin="0,4,0,4" Visibility="Collapsed">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkResetShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkResetCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkResetWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkResetAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbResetBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                    <CheckBox x:Name="ChkResetKeyboardEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlResetKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="120" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblResetKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnResetKeyRecord" Tag="Reset" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnResetKeyClear" Tag="Reset" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.Trigger.Gesture}"/>
                                    <CheckBox x:Name="ChkResetGestureEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlResetGesture" Margin="0,0,0,4" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbResetGesture" Style="{StaticResource ModernComboBoxStyle}" Width="220"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Pro Card 2: フォアグラウンド窓中央へジャンプ -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Style="{StaticResource CardIconBox}">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE737;"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.ActiveWindowJump}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Str.Settings.Card.ActiveWindowJump.Desc}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                    <CheckBox x:Name="ChkActWinMouseEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlActWinMouse" Margin="0,4,0,4" Visibility="Collapsed">
                                    <WrapPanel Margin="0,0,0,6">
                                        <CheckBox x:Name="ChkActWinShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                        <CheckBox x:Name="ChkActWinCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                        <CheckBox x:Name="ChkActWinWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                        <CheckBox x:Name="ChkActWinAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="CmbActWinBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                    <CheckBox x:Name="ChkActWinKeyboardEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlActWinKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                    <Border Style="{StaticResource KbdKeyStyle}" MinWidth="120" Padding="8,4" Margin="0,0,6,0">
                                        <TextBlock x:Name="LblActWinKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                    <Button x:Name="BtnActWinKeyRecord" Tag="ActWin" Click="OnRecordKeyClick"
                                            Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnActWinKeyClear" Tag="ActWin" Click="OnClearKeyClick"
                                            Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                </StackPanel>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.Trigger.Gesture}"/>
                                    <CheckBox x:Name="ChkActWinGestureEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                </Grid>
                                <StackPanel x:Name="PnlActWinGesture" Margin="0,0,0,4" Visibility="Collapsed">
                                    <ComboBox x:Name="CmbActWinGesture" Style="{StaticResource ModernComboBoxStyle}" Width="220"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Pro Card 3: 左クリック履歴で戻る -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7A7;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.ClickHistoryBack}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Str.Settings.Card.ClickHistoryBack.Desc}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.MouseButton}"/>
                                        <CheckBox x:Name="ChkClkBackMouseEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                    </Grid>
                                    <StackPanel x:Name="PnlClkBackMouse" Margin="0,4,0,4" Visibility="Collapsed">
                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox x:Name="ChkClkBackShift" Style="{StaticResource ModifierChipStyle}" Content="Shift"/>
                                            <CheckBox x:Name="ChkClkBackCtrl"  Style="{StaticResource ModifierChipStyle}" Content="Ctrl"/>
                                            <CheckBox x:Name="ChkClkBackWin"   Style="{StaticResource ModifierChipStyle}" Content="Win"/>
                                            <CheckBox x:Name="ChkClkBackAlt"   Style="{StaticResource ModifierChipStyle}" Content="Alt"/>
                                        </WrapPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource HintText}" Text="+" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CmbClkBackBtn" Style="{StaticResource ModernComboBoxStyle}" Width="140"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.KeyboardKey}"/>
                                        <CheckBox x:Name="ChkClkBackKeyboardEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                    </Grid>
                                    <StackPanel x:Name="PnlClkBackKeyboard" Margin="0,0,0,4" Visibility="Collapsed" Orientation="Horizontal">
                                        <Border Style="{StaticResource KbdKeyStyle}" MinWidth="120" Padding="8,4" Margin="0,0,6,0">
                                            <TextBlock x:Name="LblClkBackKey" Text="" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                        <Button x:Name="BtnClkBackKeyRecord" Tag="ClkBack" Click="OnRecordKeyClick"
                                                Content="{DynamicResource Str.Settings.RecordKey}" Margin="0,0,6,0"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button x:Name="BtnClkBackKeyClear" Tag="ClkBack" Click="OnClearKeyClick"
                                                Content="✕" Style="{StaticResource SecondaryButtonStyle}" MinWidth="32" Padding="6,4"/>
                                    </StackPanel>

                                    <Grid Margin="0,6,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.Trigger.Gesture}"/>
                                        <CheckBox x:Name="ChkClkBackGestureEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="OnTriggerEnabledChanged" Unchecked="OnTriggerEnabledChanged"/>
                                    </Grid>
                                    <StackPanel x:Name="PnlClkBackGesture" Margin="0,0,0,4" Visibility="Collapsed">
                                        <ComboBox x:Name="CmbClkBackGesture" Style="{StaticResource ModernComboBoxStyle}" Width="220"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 履歴の深さ -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.ClickHistoryDepth}"/>
                                        <TextBlock x:Name="TxtClickHistoryDepth" Grid.Column="1" Style="{StaticResource BodyText}"
                                                   VerticalAlignment="Center" Width="36" TextAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldClickHistoryDepth"
                                            Minimum="2" Maximum="10" SmallChange="1" LargeChange="1"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center" Margin="0,2,0,4"
                                            ValueChanged="OnClickHistoryDepthChanged"/>
                                    <TextBlock Text="{DynamicResource Str.Settings.ClickHistoryDepth.Hint}"
                                               Style="{StaticResource HintText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==== ジャンプ後ウィンドウアクティブ化カード ==== -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE8A7;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.ActivateWindowOnJump}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str.Settings.ActivateWindowOnJump.Hint}"
                                           Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkActivateWindowOnJump" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==== エフェクトカード ==== -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE790;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Settings.Card.Effects}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="EffectList">

                                <!-- ══ Set A ══ -->
                                <TextBlock Text="Set A" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,6"/>

                                <!-- 保存エフェクト（Set A） -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectSaveColor" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.Save.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.Save.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtSaveColorHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <CheckBox x:Name="ChkSaveEffectEnabled" Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <!-- ジャンプ軌跡（Set A）+ 展開ボタン -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectTrailColor" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.Trail.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.Trail.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtTrailColorHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ToggleButton x:Name="BtnTrailExpand" Grid.Column="4"
                                                  Checked="OnTrailExpandChecked" Unchecked="OnTrailExpandUnchecked"
                                                  Background="Transparent" BorderThickness="0"
                                                  Width="24" Height="24" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock x:Name="TxtTrailExpandIcon"
                                                   FontFamily="{StaticResource FluentIconFont}"
                                                   FontSize="12" Text="&#xE70D;"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </ToggleButton>
                                    <CheckBox x:Name="ChkTrailEffectEnabled" Grid.Column="5"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 軌跡詳細スライダー（折りたたみ） -->
                                <StackPanel x:Name="PnlTrailDetails" Margin="20,4,0,8" Visibility="Collapsed">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.Effect.Trail.Thickness}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldTrailThickness" Grid.Column="1"
                                                Minimum="1" Maximum="20" SmallChange="1" LargeChange="2"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" Margin="0,0,12,0"
                                                ValueChanged="OnTrailThicknessChanged"/>
                                        <TextBlock x:Name="TxtTrailThickness" Grid.Column="2"
                                                   Style="{StaticResource BodyText}" Width="60" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.Effect.Trail.Duration}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldTrailDuration" Grid.Column="1"
                                                Minimum="100" Maximum="3000" SmallChange="50" LargeChange="200"
                                                IsSnapToTickEnabled="True" TickFrequency="50"
                                                VerticalAlignment="Center" Margin="0,0,12,0"
                                                ValueChanged="OnTrailDurationChanged"/>
                                        <TextBlock x:Name="TxtTrailDuration" Grid.Column="2"
                                                   Style="{StaticResource BodyText}" Width="60" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" Text="{DynamicResource Str.Settings.Effect.Trail.Opacity}" VerticalAlignment="Center"/>
                                        <Slider x:Name="SldTrailOpacity" Grid.Column="1"
                                                Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1"
                                                IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                VerticalAlignment="Center" Margin="0,0,12,0"
                                                ValueChanged="OnTrailOpacityChanged"/>
                                        <TextBlock x:Name="TxtTrailOpacity" Grid.Column="2"
                                                   Style="{StaticResource BodyText}" Width="60" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 座標マーカー（Set A） -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectMarkerColor" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.Marker.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.Marker.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtMarkerColorHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <CheckBox x:Name="ChkMarkerEffectEnabled" Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4"/>

                                <!-- ══ Set B ══ -->
                                <TextBlock Text="Set B" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,6"/>

                                <!-- 保存エフェクト（Set B） -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectSaveColorB" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.SaveB.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.SaveB.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtSaveColorBHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- ジャンプ軌跡（Set B） -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectTrailColorB" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.TrailB.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.TrailB.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtTrailColorBHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- 座標マーカー（Set B） -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse x:Name="RectMarkerColorB" Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.MarkerB.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.MarkerB.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock x:Name="TxtMarkerColorBHex" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4"/>

                                <!-- 削除モードヘルプパネル -->
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CardIconBox}" Width="24" Height="24">
                                        <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE897;" FontSize="14"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.DeleteHelp.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.DeleteHelp.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeEnabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusEnabled}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                                    </Border>
                                    <CheckBox x:Name="ChkShowDeleteModeHelp" Grid.Column="3"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2"/>

                                <!-- マウス移動エフェクト（未実装プレースホルダ） -->
                                <Grid Margin="0,6" IsEnabled="False" Opacity="0.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0"
                                             Style="{StaticResource ColorSwatchStyle}"
                                             Fill="#FFCC00"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.MoveTrail.Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Str.Settings.Effect.MoveTrail.Hint}"
                                                   Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource StatusBadgeDisabledStyle}">
                                        <TextBlock Text="{DynamicResource Str.Settings.StatusNotImplemented}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource HexCodeBadgeStyle}">
                                        <TextBlock Text="#FFCC00" FontFamily="Consolas" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                    <CheckBox Grid.Column="4"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="False" IsEnabled="False"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ====== 使い方ページ ====== -->
            <ScrollViewer x:Name="PageUsage" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,8"
                          Visibility="Collapsed">
                <StackPanel>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE946;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Usage.WhatIs.Title}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       Text="{DynamicResource Str.Usage.WhatIs.Body}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE74E;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.Usage.Basics.Title}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel Margin="4,4,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="①" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Usage.Basics.Step1.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{DynamicResource Str.Usage.Basics.Step1.Prefix}" Style="{StaticResource BodyText}"/>
                                            <Border Style="{StaticResource KbdKeyStyle}"><TextBlock Text="Ctrl" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/></Border>
                                            <TextBlock Text="+" Style="{StaticResource BodyText}" Margin="2,0"/>
                                            <Border Style="{StaticResource KbdKeyStyle}"><TextBlock Text="Win" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/></Border>
                                            <TextBlock Text="{DynamicResource Str.Usage.Basics.Step1.Suffix}" Style="{StaticResource BodyText}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="②" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Usage.Basics.Step2.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                                   Text="{DynamicResource Str.Usage.Basics.Step2.Body}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="③" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Usage.Basics.Step3.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                                   Text="{DynamicResource Str.Usage.Basics.Step3.Body}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="④" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Usage.Basics.Step4.Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyText}"
                                                   Text="{DynamicResource Str.Usage.Basics.Step4.Body}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ====== 情報ページ ====== -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,8"
                          Visibility="Collapsed">
                <StackPanel>

                    <!-- アプリ情報カード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE946;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.AppName}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="AboutVersionText" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2">
                                <Hyperlink x:Name="GitHubLink" NavigateUri="https://github.com/kochanman87/CursorJump"
                                           RequestNavigate="OnHyperlinkRequestNavigate">
                                    <TextBlock Text="{DynamicResource Str.About.GitHubRepo}"/>
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="MIT License" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 自動更新カード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE777;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.About.AutoUpdate}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.About.AutoUpdate}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AboutLastCheckedText" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoUpdateToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Button x:Name="CheckNowButton"
                                    Content="{DynamicResource Str.About.CheckNow}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnCheckNowClick"/>
                        </StackPanel>
                    </Border>

                    <!-- 自動起動カード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE7E8;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.About.AutoStart}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.About.AutoStart}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Str.About.AutoStartHint}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 診断ログカード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE9F9;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.About.Diagnostics}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Str.About.DiagnosticsHint}"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str.About.VerboseLogging}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Str.About.VerboseLoggingHint}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="VerboseLoggingToggle" Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="OpenLogButton"
                                        Content="{DynamicResource Str.About.OpenLog}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="OnOpenLogClick"/>
                                <Button x:Name="OpenLogFolderButton"
                                        Content="{DynamicResource Str.About.OpenLogFolder}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnOpenLogFolderClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ====== ライセンスページ ====== -->
            <ScrollViewer x:Name="PageLicense" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,4,20,8"
                          Visibility="Collapsed">
                <StackPanel>

                    <!-- ステータスカード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource CardIconBox}">
                                    <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE192;"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardHeaderText}" Text="{DynamicResource Str.License.Header}" Margin="10,0,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="LicenseStatusText" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource Str.License.BuyHint}"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="LicenseFreeLimitsText"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- キー入力カード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.License.KeyLabel}"
                                       Style="{StaticResource BodyText}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LicenseKeyInput" Grid.Column="0"
                                         Tag="{DynamicResource Str.License.KeyPlaceholder}"
                                         FontSize="13" Padding="6,4" Margin="0,0,8,0"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="LicenseApplyButton" Grid.Column="1"
                                        Content="{DynamicResource Str.License.ApplyButton}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnLicenseApplyClick" MinWidth="80"/>
                            </Grid>
                            <TextBlock x:Name="LicenseApplyResultText"
                                       Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 購入リンクカード -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                                <Hyperlink x:Name="BoothLink" NavigateUri="https://kochanman87.booth.pm/items/8344258"
                                           RequestNavigate="OnHyperlinkRequestNavigate">
                                    <TextBlock Text="{DynamicResource Str.License.BuyButton}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ==== ボタン行 ==== -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str.Settings.Cancel}" Style="{StaticResource SecondaryButtonStyle}"
                        Width="100" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="{DynamicResource Str.Settings.Save}" Style="{StaticResource PrimaryButtonStyle}"
                        Width="100" Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
