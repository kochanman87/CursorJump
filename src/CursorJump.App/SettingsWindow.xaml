<Window x:Class="CursorJump.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CursorJump.App.Controls"
        Title="{DynamicResource Str.Settings.Title}"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="840" Height="680"
        MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}">

    <!--
      v1.12.0: CircleSwitch と同じ骨組み。左にナビ 4 項目（操作 / 見た目 / 全般 / ヘルプ）、右にカード。
      保存ボタンは無く、変えた項目はその場で保存する（SettingsWindow.xaml.cs の ScheduleSave）。Esc で閉じる。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="188"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==== 左ナビ ==== -->
        <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14,10,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,16">
                    <Image Source="pack://application:,,,/Assets/icon.ico" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.AppName}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NavVersionText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgCardBrush}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="12,10" Margin="2,0">
                    <StackPanel>
                        <TextBlock x:Name="NavEditionText" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="NavEditionSub" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavOps" GroupName="Nav" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE765;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str.Nav.Ops}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLook" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE790;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str.Nav.Look}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavGeneral" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE713;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str.Nav.General}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHelp" GroupName="Nav" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FluentIcon}" Text="&#xE897;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str.Nav.Help}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==== ページ ==== -->
        <Grid Grid.Column="1">

            <!-- ====== 操作 ====== -->
            <ScrollViewer x:Name="PageOps" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Nav.Ops}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- 1 つ目のリストと基本操作（見出しなし。アイコンの色で区別） -->
                    <Border Style="{StaticResource ListCard}">
                        <StackPanel>
                            <c:ActionRow x:Name="RowSave" TitleKey="Str.Ops.Save" Glyph="&#xE81D;" IsFirst="True"/>
                            <c:ActionRow x:Name="RowNav" TitleKey="Str.Ops.Navigate" Glyph="&#xE72A;"/>
                            <c:ActionRow x:Name="RowDisp" TitleKey="Str.Ops.Display" Glyph="&#xE81E;"/>
                            <c:ActionRow x:Name="RowMonNav" TitleKey="Str.Ops.NavigateMonitor" Glyph="&#xE7F4;"/>
                        </StackPanel>
                    </Border>

                    <!-- 2 つ目のリスト（Pro のみ表示。Free では隠す） -->
                    <Border x:Name="CardSetB" Style="{StaticResource ListCard}">
                        <StackPanel>
                            <c:ActionRow x:Name="RowSaveB" TitleKey="Str.Ops.Save" Glyph="&#xE81D;" IsSetB="True" IsFirst="True"/>
                            <c:ActionRow x:Name="RowNavB" TitleKey="Str.Ops.Navigate" Glyph="&#xE72A;" IsSetB="True"/>
                        </StackPanel>
                    </Border>

                    <!-- 追加の操作（Pro） -->
                    <Border Style="{StaticResource ListCard}">
                        <StackPanel>
                            <c:ActionRow x:Name="RowReset" TitleKey="Str.Ops.ResetCycle" Glyph="&#xE72C;" SupportsGesture="True" IsFirst="True"/>
                            <c:ActionRow x:Name="RowActWin" TitleKey="Str.Ops.ActiveWindow" Glyph="&#xE737;" SupportsGesture="True"/>
                            <c:ActionRow x:Name="RowClkBack" TitleKey="Str.Ops.ClickHistoryBack" Glyph="&#xE7A7;" SupportsGesture="True"/>
                            <!-- 「クリックした所へ戻る」の追加設定。UserControl の中では名前を付けられないため、ここに置いて読み込み時に行の Extra へ移す -->
                                    <StackPanel x:Name="ClickHistoryExtra">
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="{DynamicResource Str.Settings.ClickHistoryDepth}" Width="84" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       ToolTip="{DynamicResource Str.Settings.ClickHistoryDepth.Hint}"/>
                                            <c:StepField x:Name="StepClickHistoryDepth" Minimum="2" Maximum="10" Step="1" ValueChanged="OnStepChanged"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="{DynamicResource Str.Ops.ClickHistoryMarkers}" Width="84" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       ToolTip="{DynamicResource Str.Settings.ClickHistoryMarkers.Hint}"/>
                                            <CheckBox x:Name="ChkClickHistoryMarkersEnabled" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"
                                                      Click="OnAnyChanged"
                                                      AutomationProperties.Name="{DynamicResource Str.Settings.ClickHistoryMarkers.Show}"/>
                                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                                        IsEnabled="{Binding IsChecked, ElementName=ChkClickHistoryMarkersEnabled}">
                                                <Ellipse x:Name="RectClickHistoryMarkerColor" Style="{StaticResource ColorSwatchStyle}"
                                                         MouseLeftButtonDown="OnColorRectangleClick"
                                                         ToolTip="{DynamicResource Str.Settings.ClickHistoryMarkers.Color}"/>
                                                <TextBlock Text="{DynamicResource Str.Settings.ClickHistoryMarkers.Opacity}" Margin="14,0,8,0" VerticalAlignment="Center"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <c:StepField x:Name="StepClickHistoryMarkerOpacity" Minimum="0.1" Maximum="1" Step="0.05" Scale="100" UnitKey="Str.Unit.Percent" ValueChanged="OnStepChanged"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ====== 見た目 ====== -->
            <ScrollViewer x:Name="PageLook" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Nav.Look}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource ListCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <Ellipse x:Name="RectListColorA" DockPanel.Dock="Right" Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str.Look.ListColorA}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="RowListColorB" Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <Ellipse x:Name="RectListColorB" DockPanel.Dock="Right" Style="{StaticResource ColorSwatchStyle}"
                                             MouseLeftButtonDown="OnColorRectangleClick" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Look.ListColorB}"/>
                                        <TextBlock Text="{DynamicResource Str.Look.ListColorHint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox x:Name="ChkSaveEffectEnabled" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                    <TextBlock Text="{DynamicResource Str.Look.SaveCircle}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox x:Name="ChkTrailEffectEnabled" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                    <TextBlock Text="{DynamicResource Str.Look.Trail}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <c:StepField x:Name="StepTrailDuration" DockPanel.Dock="Right" Minimum="100" Maximum="3000" Step="100" Scale="0.001" Decimals="1" UnitKey="Str.Unit.Seconds" ValueChanged="OnStepChanged"/>
                                    <TextBlock Text="{DynamicResource Str.Look.TrailDuration}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- 詳細（普段は閉じる） -->
                            <Border Style="{StaticResource SettingRow}" MinHeight="0" Padding="0">
                                <ToggleButton x:Name="TglLookDetails" Cursor="Hand" Checked="OnLookDetailsToggled" Unchecked="OnLookDetailsToggled">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg" Background="Transparent" Padding="14,10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BgCardHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Str.Look.Details}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="TxtLookDetailsChevron" Style="{StaticResource FluentIcon}" Text="&#xE76C;" FontSize="10"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Border>
                            <StackPanel x:Name="PnlLookDetails" Visibility="Collapsed">
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <c:StepField x:Name="StepTrailThickness" DockPanel.Dock="Right" Minimum="1" Maximum="20" Step="1" UnitKey="Str.Unit.Dp" ValueChanged="OnStepChanged"/>
                                        <TextBlock Text="{DynamicResource Str.Look.TrailThickness}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <c:StepField x:Name="StepTrailOpacity" DockPanel.Dock="Right" Minimum="0.1" Maximum="1" Step="0.05" Scale="100" UnitKey="Str.Unit.Percent" ValueChanged="OnStepChanged"/>
                                        <TextBlock Text="{DynamicResource Str.Look.TrailOpacity}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="RectSaveColor" Style="{StaticResource ColorSwatchStyle}" MouseLeftButtonDown="OnColorRectangleClick"/>
                                            <Ellipse x:Name="RectSaveColorB" Style="{StaticResource ColorSwatchStyle}" Margin="10,0,0,0" MouseLeftButtonDown="OnColorRectangleClick"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Look.SaveCircleColor}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="RectTrailColor" Style="{StaticResource ColorSwatchStyle}" MouseLeftButtonDown="OnColorRectangleClick"/>
                                            <Ellipse x:Name="RectTrailColorB" Style="{StaticResource ColorSwatchStyle}" Margin="10,0,0,0" MouseLeftButtonDown="OnColorRectangleClick"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Look.TrailColor}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="RectMarkerColor" Style="{StaticResource ColorSwatchStyle}" MouseLeftButtonDown="OnColorRectangleClick"/>
                                            <Ellipse x:Name="RectMarkerColorB" Style="{StaticResource ColorSwatchStyle}" Margin="10,0,0,0" MouseLeftButtonDown="OnColorRectangleClick"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Look.MarkerColor}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkMarkerEffectEnabled" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                        <TextBlock Text="{DynamicResource Str.Look.Markers}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="ChkShowDeleteModeHelp" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                        <TextBlock Text="{DynamicResource Str.Look.DeleteHelp}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ====== 全般 ====== -->
            <ScrollViewer x:Name="PageGeneral" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Nav.General}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource ListCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <CheckBox x:Name="AutoStartToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                    <TextBlock Text="{DynamicResource Str.About.AutoStart}" VerticalAlignment="Center" ToolTip="{DynamicResource Str.About.AutoStartHint}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox x:Name="ChkActivateWindowOnJump" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                    <TextBlock Text="{DynamicResource Str.General.ActivateWindow}" VerticalAlignment="Center"
                                               ToolTip="{DynamicResource Str.Settings.ActivateWindowOnJump.Hint}"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource PillTabContainer}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDark" GroupName="ThemeToggle" Style="{StaticResource PillTabStyle}" Padding="12,4" Checked="OnThemeChecked">
                                                <TextBlock Text="{DynamicResource Str.Settings.Theme.Dark}" FontSize="12"/>
                                            </RadioButton>
                                            <RadioButton x:Name="ThemeLight" GroupName="ThemeToggle" Style="{StaticResource PillTabStyle}" Padding="12,4" Checked="OnThemeChecked">
                                                <TextBlock Text="{DynamicResource Str.Settings.Theme.Light}" FontSize="12"/>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str.General.Theme}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource PillTabContainer}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangJa" GroupName="LangToggle" Style="{StaticResource PillTabStyle}" Padding="12,4" Checked="OnLanguageChecked">
                                                <TextBlock Text="{DynamicResource Str.Settings.Language.Japanese}" FontSize="12"/>
                                            </RadioButton>
                                            <RadioButton x:Name="LangEn" GroupName="LangToggle" Style="{StaticResource PillTabStyle}" Padding="12,4" Checked="OnLanguageChecked">
                                                <TextBlock Text="{DynamicResource Str.Settings.Language.English}" FontSize="12"/>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Str.General.Language}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <CheckBox x:Name="AutoUpdateToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.About.AutoUpdate}"/>
                                        <TextBlock x:Name="AboutLastCheckedText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <Button x:Name="CheckNowButton" DockPanel.Dock="Right" Content="{DynamicResource Str.General.CheckNow}"
                                            Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Click="OnCheckNowClick"/>
                                    <TextBlock x:Name="AboutVersionText" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Str.General.License}" Style="{StaticResource GroupLabel}"/>
                    <Border Style="{StaticResource ListCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LicenseStatusText"/>
                                    <TextBlock x:Name="LicenseFreeLimitsText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel VerticalAlignment="Center">
                                    <DockPanel>
                                        <Button x:Name="LicenseApplyButton" DockPanel.Dock="Right" Content="{DynamicResource Str.License.ApplyButton}"
                                                Style="{StaticResource PrimaryButtonStyle}" Click="OnLicenseApplyClick" MinWidth="72" Margin="8,0,0,0"/>
                                        <TextBox x:Name="LicenseKeyInput" Tag="{DynamicResource Str.License.KeyPlaceholder}"
                                                 FontSize="13" Padding="6,4" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="{DynamicResource Str.License.KeyLabel}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LicenseApplyResultText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Hyperlink x:Name="BoothLink" NavigateUri="https://kochanman87.booth.pm/items/8344258"
                                                   RequestNavigate="OnHyperlinkRequestNavigate">
                                            <TextBlock Text="{DynamicResource Str.General.Open}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Str.License.BuyButton}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource Str.General.Trouble}" Style="{StaticResource GroupLabel}"/>
                    <Border Style="{StaticResource ListCard}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                                <DockPanel>
                                    <CheckBox x:Name="VerboseLoggingToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="OnAnyChanged"/>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Str.About.VerboseLogging}"/>
                                        <TextBlock Text="{DynamicResource Str.About.VerboseLoggingHint}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Str.About.OpenLog}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnOpenLogClick"/>
                                        <Button Content="{DynamicResource Str.About.OpenLogFolder}" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenLogFolderClick"/>
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Str.About.Diagnostics}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Hyperlink NavigateUri="https://github.com/kochanman87/CursorJump" RequestNavigate="OnHyperlinkRequestNavigate">
                                            <TextBlock Text="{DynamicResource Str.General.Open}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource Str.About.GitHubRepo}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ====== ヘルプ ====== -->
            <ScrollViewer x:Name="PageHelp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.Nav.Help}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Style="{StaticResource CardBorder}" Padding="16,16,16,12">
                        <c:HelpAnimation x:Name="HelpAnim" HorizontalAlignment="Center"/>
                    </Border>
                    <UniformGrid x:Name="HelpTiles" Columns="4">
                        <Border Style="{StaticResource CardBorder}" Padding="6,12,6,10" Margin="0,0,5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="HelpIconWheel" Style="{StaticResource FluentIcon}" Text="&#xE962;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Str.Help.Tile.WheelTitle}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Str.Help.Tile.WheelBody}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="6,12,6,10" Margin="5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="HelpIconDisp" Style="{StaticResource FluentIcon}" Text="&#xE81E;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="HelpTileDispTitle" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Str.Help.Tile.DisplayBody}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="HelpTileSetB" Style="{StaticResource CardBorder}" Padding="6,12,6,10" Margin="5,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="HelpIconSetB" Style="{StaticResource FluentIcon}" Text="&#xE81D;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="#FF7FA8"/>
                                <TextBlock x:Name="HelpTileSetBTitle" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Str.Help.Tile.SetBBody}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="6,12,6,10" Margin="5,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="HelpIconMonitor" Style="{StaticResource FluentIcon}" Text="&#xE7F4;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{DynamicResource Str.Help.Tile.MonitorTitle}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{DynamicResource Str.Help.Tile.MonitorBody}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==== 下の知らせ（保存できなかった理由など。普段は出さない） ==== -->
        <Border x:Name="MessageBar" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" Margin="24,0,24,12" Padding="12,8" CornerRadius="6"
                Background="#33F2B866" BorderBrush="#F2B866" BorderThickness="1">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>
    </Grid>
</Window>
