<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- DPI awareness は app.manifest で宣言する (ApplicationHighDpiMode は WinForms 専用で WPF には無効)。
         WFAC010 は「manifest でなく ApplicationHighDpiMode を使え」という WinForms 向け警告のため抑止する。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>1.9.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Include="app.manifest" />
    <Resource Include="Assets\icon.ico" />
    <None Update="runtimeconfig.template.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CursorJump.Tests" />
  </ItemGroup>
</Project>
